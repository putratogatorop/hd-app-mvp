# ============================================
# HD App MVP - Environment Variables
# Copy this to .env.local and fill in real values.
# Never commit .env.local. Mirror these keys in Vercel
# (Project → Settings → Environment Variables) for prod/preview.
# ============================================

# ── Supabase (REQUIRED) ──
# Dashboard: https://supabase.com/dashboard/project/hxxiiwlvkatcdzlhxyqq → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
# Server-only. Never expose to the client. Used by service-role admin ops.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Lark / Feishu notifications (OPTIONAL — only if /api/lark/webhook is wired) ──
# Lark Open Platform → your bot app → Credentials & Basic Info
LARK_APP_ID=cli_YOUR_APP_ID
LARK_APP_SECRET=YOUR_APP_SECRET
# Verification token from the Event Subscriptions tab
LARK_VERIFICATION_TOKEN=YOUR_VERIFICATION_TOKEN
# Chat ID for the PM group that receives notifications
LARK_CHAT_PM=oc_YOUR_CHAT_ID

# ── WhatsApp gifting stub (OPTIONAL — only if gifting → WhatsApp send is enabled) ──
WHATSAPP_API_URL=https://your-whatsapp-provider.example.com/v1/messages
WHATSAPP_API_TOKEN=YOUR_PROVIDER_TOKEN
